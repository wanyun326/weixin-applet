.intro {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
}

.intro__family {
  font-size: 24rpx;
  color: #B85434;
  margin-bottom: 6rpx;
}

.intro__title {
  font-size: 32rpx;
  font-weight: 700;
}

.intro__desc {
  margin-top: 8rpx;
  line-height: 1.5;
}

.search {
  display: flex;
  align-items: center;
  height: 82rpx;
  margin-bottom: 24rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  background: var(--card);
}

.search__icon {
  margin-right: 12rpx;
  font-size: 30rpx;
}

.search__input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
}

.search__clear {
  padding-left: 16rpx;
  color: #B85434;
  font-size: 24rpx;
}

.dish-section {
  margin-bottom: 28rpx;
}

.dish-section__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 0 8rpx 12rpx;
}

.dish-section__title {
  font-size: 30rpx;
  font-weight: 600;
}

.tag--builtin {
  background: #E8F1FF;
  color: #3F6EA8;
}

.tag--custom {
  background: #E5EDE7;
  color: #1E7F76;
}

.custom-dish {
  display: flex;
  align-items: center;
}

.custom-dish__img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  background: #F0F1F5;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.custom-dish__body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.custom-dish__name {
  font-size: 30rpx;
  font-weight: 600;
}

.custom-dish__desc {
  line-height: 1.4;
}

.custom-dish__actions {
  display: flex;
  gap: 14rpx;
  margin-top: 4rpx;
}

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(24, 25, 28, 0.48);
}

.sheet {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  padding: 30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
}

.sheet__title {
  margin-bottom: 24rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.image-upload {
  display: flex;
  align-items: center;
  width: 100%;
  margin-bottom: 24rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: #F7F8FA;
  text-align: left;
  line-height: normal;
}

.image-upload::after {
  border: none;
}

.image-upload__preview {
  width: 150rpx;
  height: 120rpx;
  margin-right: 20rpx;
  border-radius: 14rpx;
  background: #EDEFF3;
}

.image-upload__hint {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 28rpx;
  color: #333;
}

.field {
  margin-bottom: 22rpx;
}

.field__label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 26rpx;
  color: #6E6258;
}

.field__input,
.field__picker {
  width: 100%;
  min-height: 82rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  background: #F3EFE7;
  font-size: 28rpx;
  line-height: 82rpx;
}

.sheet__actions {
  display: flex;
  gap: 18rpx;
  margin-top: 30rpx;
}
