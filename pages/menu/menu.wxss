.menu-page {
  background:
    radial-gradient(circle at 100% 0, rgba(184, 84, 52, 0.08), transparent 38%),
    var(--bg);
}

.menu-head {
  padding: 14rpx 6rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
  margin-bottom: 30rpx;
}

.menu-head__top {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.eyebrow {
  display: block;
  color: var(--primary);
  font-size: 22rpx;
  letter-spacing: 3rpx;
  margin-bottom: 8rpx;
}

.menu-head__title {
  display: block;
  color: var(--text);
  font-family: "Songti SC", "STSong", serif;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.3;
}

.menu-head__share {
  flex-shrink: 0;
  min-width: 104rpx;
  height: 58rpx;
  margin: 4rpx 0 0;
  padding: 0 20rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 10rpx;
  background: rgba(255, 253, 248, 0.72);
  color: var(--text-2);
  font-size: 24rpx;
  line-height: 58rpx;
}

.menu-head__links {
  display: flex;
  gap: 30rpx;
  margin-top: 22rpx;
  color: var(--text-2);
  font-size: 24rpx;
}

.menu-head__links text {
  padding-bottom: 4rpx;
  border-bottom: 2rpx solid var(--primary-soft);
}

.start-card {
  text-align: left;
  padding: 48rpx 34rpx;
}

.start-card__mark {
  display: inline-block;
  padding: 5rpx 12rpx;
  border-radius: 6rpx;
  background: var(--primary-soft);
  color: var(--primary-deep);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.start-card__title {
  margin: 20rpx 0 10rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 36rpx;
  font-weight: 700;
}

.start-card__btn {
  margin-top: 30rpx;
}

.section {
  margin-bottom: 38rpx;
}

.section__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 6rpx 16rpx;
}

.section__kicker {
  display: block;
  margin-bottom: 2rpx;
  color: var(--text-3);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.section__title {
  display: block;
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

.section--prepared .section__title {
  color: var(--accent-deep);
}

.section__count {
  color: var(--text-3);
  font-size: 23rpx;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.order {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-radius: 12rpx;
  box-shadow: none;
}

.order__img {
  width: 116rpx;
  height: 116rpx;
  border-radius: 8rpx;
  background: var(--surface-soft);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.order__body {
  min-height: 116rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.order__name {
  font-size: 31rpx;
  font-weight: 600;
}

.order__qty {
  color: var(--primary-deep);
  font-size: 23rpx;
}

.order__meta {
  margin-top: 8rpx;
}

.order__actions {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.order--prepared {
  background: var(--surface-sage);
  border-color: #CBD9CF;
}

.order__ready {
  width: 44rpx;
  height: 44rpx;
  margin-left: 16rpx;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  font-size: 25rpx;
  line-height: 44rpx;
  text-align: center;
  flex-shrink: 0;
}

.btn--quiet {
  background: transparent;
  border: 1rpx solid var(--line-strong);
  color: var(--text-2);
}

.group__empty {
  padding: 30rpx 24rpx;
  border: 1rpx dashed var(--line-strong);
  border-radius: 12rpx;
  color: var(--text-3);
  font-size: 25rpx;
  text-align: center;
}

.footer {
  display: flex;
  gap: 16rpx;
  margin-top: 10rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--line);
}

.footer__logs,
.footer__close {
  flex: 1;
}
