.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tabs__item {
  flex: 1;
  text-align: center;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
  color: #6E6258;
  font-size: 28rpx;
}

.tabs__item.is-active {
  background: var(--primary-soft);
  color: #8D3D26;
  font-weight: 600;
}

.privacy-note {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border: 1rpx solid rgba(184, 84, 52, 0.16);
  border-radius: 16rpx;
  background: rgba(255, 253, 248, 0.72);
}

.privacy-note__title,
.privacy-note__text {
  display: block;
}

.privacy-note__title {
  margin-bottom: 8rpx;
  color: #8D3D26;
  font-size: 25rpx;
  font-weight: 600;
}

.privacy-note__text {
  color: #786D63;
  font-size: 24rpx;
  line-height: 1.65;
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
}

.avatar-btn {
  padding: 0;
  background: transparent;
  line-height: normal;
}

.input {
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  background: #F3EFE7;
  font-size: 28rpx;
}

.input--full {
  width: 100%;
}

.input--code {
  letter-spacing: 6rpx;
  font-weight: 600;
}

.tip {
  margin-top: 16rpx;
  line-height: 1.6;
}

.submit {
  margin-top: 40rpx;
}
