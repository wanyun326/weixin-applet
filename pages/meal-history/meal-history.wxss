.meal {
  padding: 24rpx;
}

.meal__meta {
  margin-top: 8rpx;
}

.meal__toggle {
  font-size: 26rpx;
  color: #FF7043;
}

.meal__loading {
  padding: 20rpx 0;
  text-align: center;
}

.order-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.order-row__img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #F0F1F5;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.order-row__name {
  font-size: 30rpx;
  font-weight: 500;
}

.meal__logs {
  margin-top: 20rpx;
}
