.meal {
  padding: 24rpx;
}

.meal__meta {
  margin-top: 8rpx;
}

.meal__toggle {
  font-size: 26rpx;
  color: #B85434;
}

.meal__loading {
  padding: 20rpx 0;
  text-align: center;
}

.order-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.order-row__img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #F0F1F5;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.order-row__name {
  font-size: 30rpx;
  font-weight: 500;
}

.meal__logs {
  margin-top: 20rpx;
}

.meal-record {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: #FFF8F5;
}

.meal-record__label {
  margin-bottom: 10rpx;
  color: #B85434;
  font-size: 24rpx;
  font-weight: 600;
}

.meal-record__note {
  color: #3D3934;
  font-size: 27rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.meal-record__by {
  margin-top: 10rpx;
  text-align: right;
}

.meal-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.meal-photo {
  width: calc((100% - 24rpx) / 3);
  height: 184rpx;
  border-radius: 14rpx;
  background: #F0F1F5;
}
