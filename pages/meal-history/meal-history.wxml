<view class="page">
  <view wx:if="{{loading}}" class="empty"><text class="empty__emoji">⏳</text><text>加载中...</text></view>

  <block wx:elif="{{meals.length}}">
    <view wx:for="{{meals}}" wx:key="_id" class="card meal">
      <view class="row-between" data-index="{{index}}" bindtap="onTapMeal">
        <view class="flex-1">
          <view class="title">{{item.label}}</view>
          <view class="muted meal__meta">{{item.createdAtText}} 开启 · {{item.closedAtText}} 结束</view>
        </view>
        <text class="meal__toggle">{{openMealId === item._id ? '收起 ▴' : '查看 ▾'}}</text>
      </view>

      <block wx:if="{{openMealId === item._id}}">
        <view class="divider"></view>
        <view wx:if="{{ordersLoading}}" class="muted meal__loading">加载中...</view>
        <block wx:elif="{{orders.length}}">
          <view wx:for="{{orders}}" wx:for-item="order" wx:key="_id" class="order-row">
            <image class="order-row__img" src="{{order.dishImage}}" mode="aspectFill" lazy-load></image>
            <view class="flex-1">
              <text class="order-row__name">{{order.dishName}}{{order.quantity > 1 ? ' ×' + order.quantity : ''}}</text>
              <view class="muted">{{order.orderedByName}} 点 · {{order.statusText}}</view>
            </view>
          </view>
        </block>
        <view wx:else class="muted meal__loading">这一餐没有点菜记录</view>
        <view class="btn btn--ghost btn--block meal__logs" data-index="{{index}}" catchtap="goLogs">查看操作记录</view>
      </block>
    </view>
  </block>

  <view wx:else class="empty">
    <text class="empty__emoji">📭</text>
    <text>还没有已结束的餐次</text>
  </view>
</view>
