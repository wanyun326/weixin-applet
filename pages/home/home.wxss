.header {
  padding: 12rpx 6rpx 26rpx;
  margin-bottom: 24rpx;
  color: var(--text);
  border-bottom: 1rpx solid var(--line);
}

.header__eyebrow {
  display: block;
  margin-bottom: 7rpx;
  color: var(--primary);
  font-size: 21rpx;
  letter-spacing: 3rpx;
}

.header__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.header__family {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.header__name {
  font-family: "Songti SC", "STSong", serif;
  font-size: 42rpx;
  font-weight: 700;
}

.header__switch {
  color: var(--text-3);
  font-size: 22rpx;
  padding-bottom: 5rpx;
  border-bottom: 1rpx solid var(--line-strong);
}

.header__share {
  flex-shrink: 0;
  height: 58rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 10rpx;
  background: rgba(255, 253, 248, 0.72);
  color: var(--text-2);
  font-size: 23rpx;
  line-height: 58rpx;
}

.header__meal {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.header__meal-label {
  font-size: 28rpx;
  font-weight: 600;
}

.header__meal-label--idle {
  color: var(--text-2);
  font-weight: 400;
}

.header__menu-link {
  color: var(--primary-deep);
  font-size: 24rpx;
}

.header__links {
  display: flex;
  gap: 28rpx;
  margin-top: 16rpx;
  color: var(--text-2);
  font-size: 23rpx;
}

.header__links text {
  padding-bottom: 3rpx;
  border-bottom: 2rpx solid var(--primary-soft);
}

.picked {
  margin-bottom: 20rpx;
  border: 1rpx solid #CDDCD2;
  background: var(--surface-sage);
  box-shadow: none;
}

.search {
  display: flex;
  align-items: center;
  height: 82rpx;
  margin-bottom: 20rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  background: var(--card);
}

.search__icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  border: 1rpx solid var(--text-3);
  border-radius: 50%;
  color: var(--text-3);
  font-size: 18rpx;
  line-height: 30rpx;
  text-align: center;
}

.search__input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
}

.search__clear {
  padding-left: 16rpx;
  color: var(--primary);
  font-size: 24rpx;
}

.picked__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.picked__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--accent-deep);
}

.picked__count {
  font-size: 24rpx;
  color: #6E6258;
}

.picked__scroll {
  width: 100%;
  white-space: nowrap;
}

.picked__list {
  display: inline-flex;
  gap: 14rpx;
  padding-bottom: 4rpx;
}

.picked__item {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 18rpx;
  border-radius: 8rpx;
  background: var(--pending-soft);
  color: #855E25;
}

.picked__withdraw {
  padding-left: 12rpx;
  border-left: 1rpx solid rgba(133, 94, 37, 0.28);
  color: var(--danger);
  font-size: 22rpx;
  font-weight: 600;
}

.picked__item--cooking {
  background: var(--done-soft);
  color: var(--accent-deep);
}

.picked__item--prepared,
.picked__item--done {
  background: var(--done-soft);
  color: var(--accent-deep);
}

.picked__name {
  font-size: 26rpx;
  font-weight: 600;
}

.picked__status {
  font-size: 22rpx;
  opacity: 0.82;
}

.start-card {
  text-align: left;
  padding: 46rpx 34rpx;
}

.start-card__mark {
  display: inline-block;
  padding: 5rpx 12rpx;
  border-radius: 6rpx;
  background: var(--primary-soft);
  color: var(--primary-deep);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.start-card__title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  font-weight: 700;
  margin: 18rpx 0 8rpx;
}

.start-card__btn {
  margin-top: 32rpx;
}

.cats {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.cats__item {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 32rpx;
  margin-right: 16rpx;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  background: var(--card);
  color: var(--text-2);
  font-size: 26rpx;
}

.cats__item.is-active {
  border-color: var(--primary);
  background: var(--primary);
  color: #fff;
  font-weight: 600;
}

.mom-guide {
  margin-bottom: 20rpx;
  border: 1rpx solid #FFD6E2;
  background: #FFF9F6;
  box-shadow: none;
}

.mom-guide__title {
  margin-bottom: 10rpx;
  color: #C94C78;
  font-size: 28rpx;
  font-weight: 600;
}

.mom-guide__text {
  color: #5E4B53;
  font-size: 25rpx;
  line-height: 1.65;
}

.mom-guide__tip {
  margin-top: 10rpx;
  color: #9A6B7C;
  font-size: 22rpx;
  line-height: 1.5;
}

.mom-guide__allergy {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #FFF0F4;
  color: #8C435D;
  font-size: 23rpx;
  line-height: 1.6;
}

.dish {
  display: flex;
  align-items: center;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  box-shadow: none;
  transition: background 0.2s ease, border-color 0.2s ease;
}

.dish--ordered {
  border-color: #C8D8CD;
  background: var(--surface-sage);
}

.dish__img {
  width: 132rpx;
  height: 132rpx;
  border-radius: 8rpx;
  background: var(--surface-soft);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.dish__info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.dish__heading {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.dish__name {
  font-family: "Songti SC", "STSong", serif;
  font-size: 32rpx;
  font-weight: 700;
}

.dish__badge {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: var(--done-soft);
  color: var(--accent-deep);
  font-size: 20rpx;
  font-weight: 600;
}

.dish__mom-badge {
  flex-shrink: 0;
  padding: 4rpx 10rpx;
  border-radius: 16rpx;
  background: #FFECF2;
  color: #C94C78;
  font-size: 19rpx;
  font-weight: 600;
}

.dish__desc {
  line-height: 1.4;
}

.dish__ordered-desc {
  color: var(--accent-deep);
  font-size: 24rpx;
}

.dish__add {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.dish__add--selected {
  background: var(--done-soft);
  color: var(--accent-deep);
  border: 1rpx solid #BFD1C5;
  font-weight: 600;
}

.dish__withdraw {
  border: 1rpx solid rgba(169, 74, 58, 0.34);
  background: transparent;
  color: var(--danger);
}

.empty-title {
  display: block;
  margin-bottom: 10rpx;
  color: var(--text-2);
  font-size: 30rpx;
  font-weight: 600;
}
