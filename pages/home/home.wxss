.header {
  background: linear-gradient(135deg, #FF8A5B, #FF7043);
  border-radius: 20rpx;
  padding: 28rpx;
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 112, 67, 0.25);
}

.header__family {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.header__name {
  font-size: 38rpx;
  font-weight: 700;
}

.header__switch {
  font-size: 24rpx;
  opacity: 0.9;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.2);
}

.header__history {
  font-size: 24rpx;
  opacity: 0.92;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.18);
}

.header__tools {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.header__manage {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.28);
}

.header__meal {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
}

.header__meal-label {
  font-size: 30rpx;
  font-weight: 600;
}

.header__meal-label--idle {
  opacity: 0.85;
  font-weight: 400;
}

.header__menu-link {
  font-size: 26rpx;
  opacity: 0.95;
}

.picked {
  margin-bottom: 20rpx;
  border: 1rpx solid #C8EEE8;
  background: linear-gradient(135deg, #FFFFFF, #F3FFFC);
}

.search {
  display: flex;
  align-items: center;
  height: 82rpx;
  margin-bottom: 20rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(45, 42, 38, 0.05);
}

.search__icon {
  margin-right: 12rpx;
  font-size: 30rpx;
}

.search__input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
}

.search__clear {
  padding-left: 16rpx;
  color: #FF7043;
  font-size: 24rpx;
}

.picked__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.picked__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E7F76;
}

.picked__count {
  font-size: 24rpx;
  color: #6B6F76;
}

.picked__scroll {
  width: 100%;
  white-space: nowrap;
}

.picked__list {
  display: inline-flex;
  gap: 14rpx;
  padding-bottom: 4rpx;
}

.picked__item {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 18rpx;
  border-radius: 24rpx;
  background: #FFF3D6;
  color: #8A5B00;
}

.picked__item--cooking {
  background: #FFE7DE;
  color: #C63C12;
}

.picked__item--done {
  background: #DFF3F0;
  color: #1E7F76;
}

.picked__name {
  font-size: 26rpx;
  font-weight: 600;
}

.picked__status {
  font-size: 22rpx;
  opacity: 0.82;
}

.start-card {
  text-align: center;
  padding: 56rpx 32rpx;
}

.start-card__title {
  font-size: 34rpx;
  font-weight: 600;
  margin: 12rpx 0 8rpx;
}

.start-card__btn {
  margin-top: 32rpx;
}

.cats {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.cats__item {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 32rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: #fff;
  color: #6B6F76;
  font-size: 28rpx;
}

.cats__item.is-active {
  background: #FF7043;
  color: #fff;
  font-weight: 600;
}

.mom-guide {
  margin-bottom: 20rpx;
  border: 1rpx solid #FFD6E2;
  background: linear-gradient(135deg, #FFF9FB, #FFF2F6);
}

.mom-guide__title {
  margin-bottom: 10rpx;
  color: #C94C78;
  font-size: 28rpx;
  font-weight: 600;
}

.mom-guide__text {
  color: #5E4B53;
  font-size: 25rpx;
  line-height: 1.65;
}

.mom-guide__tip {
  margin-top: 10rpx;
  color: #9A6B7C;
  font-size: 22rpx;
  line-height: 1.5;
}

.mom-guide__allergy {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #FFF0F4;
  color: #8C435D;
  font-size: 23rpx;
  line-height: 1.6;
}

.dish {
  display: flex;
  align-items: center;
  border: 2rpx solid transparent;
  transition: background 0.2s ease, border-color 0.2s ease;
}

.dish--ordered {
  border-color: #9DDDD4;
  background: linear-gradient(135deg, #FFFFFF, #F0FFFC);
}

.dish__img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: #F0F1F5;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.dish__info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.dish__heading {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.dish__name {
  font-size: 32rpx;
  font-weight: 600;
}

.dish__badge {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 18rpx;
  background: #DFF3F0;
  color: #1E7F76;
  font-size: 20rpx;
  font-weight: 600;
}

.dish__mom-badge {
  flex-shrink: 0;
  padding: 4rpx 10rpx;
  border-radius: 16rpx;
  background: #FFECF2;
  color: #C94C78;
  font-size: 19rpx;
  font-weight: 600;
}

.dish__desc {
  line-height: 1.4;
}

.dish__ordered-desc {
  color: #1E7F76;
  font-size: 24rpx;
}

.dish__add {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.dish__add--selected {
  background: #DFF3F0;
  color: #1E7F76;
  border: 1rpx solid #A9DDD7;
  font-weight: 600;
}
