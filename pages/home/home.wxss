.header {
  background: linear-gradient(135deg, #FF8A5B, #FF7043);
  border-radius: 20rpx;
  padding: 28rpx;
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 112, 67, 0.25);
}

.header__family {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.header__name {
  font-size: 38rpx;
  font-weight: 700;
}

.header__switch {
  font-size: 24rpx;
  opacity: 0.9;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.2);
}

.header__history {
  font-size: 24rpx;
  opacity: 0.92;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.18);
}

.header__meal {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
}

.header__meal-label {
  font-size: 30rpx;
  font-weight: 600;
}

.header__meal-label--idle {
  opacity: 0.85;
  font-weight: 400;
}

.header__menu-link {
  font-size: 26rpx;
  opacity: 0.95;
}

.start-card {
  text-align: center;
  padding: 56rpx 32rpx;
}

.start-card__title {
  font-size: 34rpx;
  font-weight: 600;
  margin: 12rpx 0 8rpx;
}

.start-card__btn {
  margin-top: 32rpx;
}

.cats {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.cats__item {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 32rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: #fff;
  color: #6B6F76;
  font-size: 28rpx;
}

.cats__item.is-active {
  background: #FF7043;
  color: #fff;
  font-weight: 600;
}

.dish {
  display: flex;
  align-items: center;
}

.dish__img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: #F0F1F5;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.dish__info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.dish__name {
  font-size: 32rpx;
  font-weight: 600;
}

.dish__desc {
  line-height: 1.4;
}

.dish__add {
  flex-shrink: 0;
  margin-left: 16rpx;
}
