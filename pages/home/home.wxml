<view class="page page--tab">
  <!-- 顶部信息 -->
  <view class="header">
    <view class="row-between">
      <view class="header__family" bindtap="goSwitchFamily">
        <text class="header__name">{{familyName}}</text>
        <text class="header__switch">切换 ▾</text>
      </view>
      <view class="header__tools">
        <text class="header__manage" bindtap="goCustomMenu">自定义菜单</text>
        <text class="header__history" bindtap="goHistory">历史当餐</text>
      </view>
    </view>
    <view class="header__meal">
      <text wx:if="{{meal}}" class="header__meal-label">🍽️ {{mealLabel}}</text>
      <text wx:else class="header__meal-label header__meal-label--idle">还没有进行中的一餐</text>
      <text wx:if="{{meal}}" class="header__menu-link" bindtap="goMenu">查看菜单 ›</text>
    </view>
  </view>

  <!-- 没有当餐 -->
  <view wx:if="{{!meal && !loading}}" class="card start-card">
    <text class="empty__emoji">🥢</text>
    <view class="start-card__title">开始新的一餐</view>
    <view class="muted">开启后，家庭成员就可以一起点菜啦</view>
    <view class="btn btn--primary start-card__btn {{starting ? 'btn--disabled' : ''}}" bindtap="onStartMeal">
      {{starting ? '开启中...' : '开始新的一餐'}}
    </view>
  </view>

  <!-- 菜品 -->
  <block wx:if="{{meal}}">
    <view class="search">
      <text class="search__icon">🔍</text>
      <input
        class="search__input"
        placeholder="搜索菜名、描述或分类"
        confirm-type="search"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
      />
      <text wx:if="{{searchKeyword}}" class="search__clear" bindtap="clearSearch">清除</text>
    </view>

    <!-- 当前当餐已点清单：始终展示菜名，切换分类也不会丢 -->
    <view wx:if="{{orderedDishes.length}}" class="card picked">
      <view class="picked__head">
        <view class="picked__title">本餐已点</view>
        <text class="picked__count">{{orderedDishes.length}} 道</text>
      </view>
      <scroll-view class="picked__scroll" scroll-x enable-flex>
        <view class="picked__list">
          <view
            wx:for="{{orderedDishes}}"
            wx:key="dishId"
            class="picked__item picked__item--{{item.status}}"
          >
            <text class="picked__name">{{item.dishName}}</text>
            <text class="picked__status">{{item.statusText}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <scroll-view wx:if="{{!searchKeyword}}" class="cats" scroll-x enable-flex>
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="cats__item {{activeCategory === item ? 'is-active' : ''}}"
        data-category="{{item}}"
        bindtap="onSelectCategory"
      >{{item}}</view>
    </scroll-view>

    <view wx:if="{{activeCategory === '宝妈专属' && !searchKeyword}}" class="card mom-guide">
      <view class="mom-guide__title">月子期这样吃更稳妥</view>
      <view class="mom-guide__text">优先选择清淡、熟透、易消化的菜，保证优质蛋白、蔬菜、主食和汤水搭配；少油少盐，暂时避免酒精、生食和过辣食物。</view>
      <view class="mom-guide__allergy">哺乳期如果宝宝出现明确过敏表现，例如湿疹明显加重或频繁腹泻，可在医生指导下逐一排查并短期回避可疑食物；不要自行大范围忌口。</view>
      <view class="mom-guide__tip">如有剖宫产恢复、妊娠糖尿病、高血压或食物过敏，请按医生建议调整。</view>
    </view>

    <view wx:if="{{loading}}" class="empty"><text class="empty__emoji">⏳</text><text>加载中...</text></view>

    <block wx:elif="{{dishes.length}}">
      <view
        wx:for="{{dishes}}"
        wx:key="_id"
        class="card dish {{item.ordered ? 'dish--ordered' : ''}}"
      >
        <image class="dish__img" src="{{item.imageUrl}}" mode="aspectFill" lazy-load></image>
        <view class="flex-1 dish__info">
          <view class="dish__heading">
            <text class="dish__name">{{item.name}}</text>
            <text wx:if="{{item.postpartumFriendly}}" class="dish__mom-badge">宝妈推荐</text>
            <text wx:if="{{item.ordered}}" class="dish__badge">✓ 已点</text>
          </view>
          <text wx:if="{{item.ordered}}" class="dish__ordered-desc">
            已加入本餐菜单 · {{item.orderStatusText}}
          </text>
          <text wx:else class="muted dish__desc">{{item.desc}}</text>
        </view>
        <view
          class="btn btn--sm {{item.ordered ? 'dish__add--selected' : 'btn--primary'}} dish__add"
          data-id="{{item._id}}"
          bindtap="onAddDish"
        >{{item.ordered ? '已点 ✓' : '＋ 加一道'}}</view>
      </view>
    </block>

    <view wx:else class="empty">
      <text class="empty__emoji">{{searchKeyword ? '🔍' : '🍽️'}}</text>
      <text>{{searchKeyword ? '没有找到相关菜品' : '这个分类还没有菜品'}}</text>
    </view>
  </block>
</view>
