<view class="page page--tab">
  <!-- 顶部信息 -->
  <view class="header">
    <view class="row-between">
      <view class="header__family" bindtap="goSwitchFamily">
        <text class="header__name">{{familyName}}</text>
        <text class="header__switch">切换 ▾</text>
      </view>
      <text class="header__history" bindtap="goHistory">历史当餐</text>
    </view>
    <view class="header__meal">
      <text wx:if="{{meal}}" class="header__meal-label">🍽️ {{mealLabel}}</text>
      <text wx:else class="header__meal-label header__meal-label--idle">还没有进行中的一餐</text>
      <text wx:if="{{meal}}" class="header__menu-link" bindtap="goMenu">查看菜单 ›</text>
    </view>
  </view>

  <!-- 没有当餐 -->
  <view wx:if="{{!meal && !loading}}" class="card start-card">
    <text class="empty__emoji">🥢</text>
    <view class="start-card__title">开始新的一餐</view>
    <view class="muted">开启后，家庭成员就可以一起点菜啦</view>
    <view class="btn btn--primary start-card__btn {{starting ? 'btn--disabled' : ''}}" bindtap="onStartMeal">
      {{starting ? '开启中...' : '开始新的一餐'}}
    </view>
  </view>

  <!-- 菜品 -->
  <block wx:if="{{meal}}">
    <scroll-view class="cats" scroll-x enable-flex>
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="cats__item {{activeCategory === item ? 'is-active' : ''}}"
        data-category="{{item}}"
        bindtap="onSelectCategory"
      >{{item}}</view>
    </scroll-view>

    <view wx:if="{{loading}}" class="empty"><text class="empty__emoji">⏳</text><text>加载中...</text></view>

    <block wx:elif="{{dishes.length}}">
      <view wx:for="{{dishes}}" wx:key="_id" class="card dish">
        <image class="dish__img" src="{{item.imageUrl}}" mode="aspectFill" lazy-load></image>
        <view class="flex-1 dish__info">
          <text class="dish__name">{{item.name}}</text>
          <text class="muted dish__desc">{{item.desc}}</text>
        </view>
        <view class="btn btn--sm btn--primary dish__add" data-id="{{item._id}}" bindtap="onAddDish">＋ 加一道</view>
      </view>
    </block>

    <view wx:else class="empty">
      <text class="empty__emoji">🍽️</text>
      <text>这个分类还没有菜品</text>
    </view>
  </block>
</view>
