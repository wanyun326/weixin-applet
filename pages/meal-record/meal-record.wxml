<view class="page">
  <view class="card head-card">
    <view class="head-card__label">餐后记录</view>
    <view class="head-card__meal">{{mealLabel || '这一餐'}}</view>
    <view class="muted head-card__tip">记录今天吃了什么、味道如何，留一张全家吃饭的照片。</view>
  </view>

  <view class="section-title">这一餐吃了什么</view>
  <view wx:if="{{loading}}" class="card empty-row">加载菜品中...</view>
  <view wx:elif="{{orders.length}}" class="card dish-summary">
    <view wx:for="{{orders}}" wx:key="_id" class="dish-summary__row">
      <image class="dish-summary__img" src="{{item.dishImage}}" mode="aspectFill" lazy-load></image>
      <view class="flex-1">
        <view class="dish-summary__name">{{item.dishName}}</view>
        <view class="muted">{{item.orderedByName}} 点的</view>
      </view>
    </view>
  </view>
  <view wx:else class="card empty-row">这一餐没有点菜记录</view>

  <view class="section-title">餐后留影</view>
  <view class="card record-card">
    <view class="photo-grid">
      <view wx:for="{{photos}}" wx:key="*this" class="photo-item">
        <image
          class="photo-item__img"
          src="{{item}}"
          mode="aspectFill"
          data-url="{{item}}"
          bindtap="previewPhoto"
        ></image>
        <view class="photo-item__remove" data-index="{{index}}" catchtap="removePhoto">×</view>
      </view>
      <view wx:if="{{photos.length < maxPhotos}}" class="photo-add" bindtap="onChoosePhotos">
        <text class="photo-add__icon">＋</text>
        <text class="photo-add__text">添加照片</text>
      </view>
    </view>
    <view class="muted photo-tip">最多 {{maxPhotos}} 张，可拍照或从相册选择</view>

    <textarea
      class="note-input"
      maxlength="500"
      auto-height
      placeholder="写一点这一餐的回忆，比如谁最捧场、哪道菜最受欢迎……"
      value="{{postNote}}"
      bindinput="onNoteInput"
    ></textarea>
    <view class="note-count">{{postNote.length}} / 500</view>
  </view>

  <view class="actions">
    <view class="btn btn--ghost" bindtap="onDirectClose">直接结束</view>
    <view
      class="btn btn--primary flex-1 {{submitting ? 'btn--disabled' : ''}}"
      bindtap="onSubmit"
    >{{submitting ? '保存中...' : '保存留影并结束'}}</view>
  </view>
</view>
