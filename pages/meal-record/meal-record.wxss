.head-card {
  margin-bottom: 28rpx;
  background: var(--surface-soft);
  color: var(--text);
  box-shadow: none;
}

.head-card__label {
  font-size: 24rpx;
  color: var(--primary);
}

.head-card__meal {
  font-family: "Songti SC", "STSong", serif;
  margin: 8rpx 0;
  font-size: 38rpx;
  font-weight: 700;
}

.head-card__tip {
  color: var(--text-2);
  line-height: 1.5;
}

.dish-summary {
  padding-top: 10rpx;
  padding-bottom: 10rpx;
}

.dish-summary__row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.dish-summary__row + .dish-summary__row {
  border-top: 1rpx solid #F0F1F5;
}

.dish-summary__img {
  width: 76rpx;
  height: 76rpx;
  margin-right: 18rpx;
  border-radius: 12rpx;
  background: #F0F1F5;
}

.dish-summary__name {
  margin-bottom: 6rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-row {
  padding: 30rpx;
  color: #978A7D;
  text-align: center;
}

.record-card {
  margin-bottom: 28rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.photo-item,
.photo-add {
  position: relative;
  width: calc((100% - 28rpx) / 3);
  height: 190rpx;
  overflow: hidden;
  border-radius: 16rpx;
}

.photo-item__img {
  width: 100%;
  height: 100%;
}

.photo-item__remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.58);
  color: #fff;
  font-size: 32rpx;
  line-height: 40rpx;
  text-align: center;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #FFD0C0;
  background: #FFF8F5;
  color: #B85434;
}

.photo-add__icon {
  font-size: 52rpx;
  line-height: 1;
}

.photo-add__text {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.photo-tip {
  margin-top: 12rpx;
}

.note-input {
  width: 100%;
  min-height: 220rpx;
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #F7F8FA;
  font-size: 28rpx;
  line-height: 1.6;
}

.note-count {
  margin-top: 8rpx;
  color: #978A7D;
  font-size: 22rpx;
  text-align: right;
}

.actions {
  display: flex;
  gap: 18rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
