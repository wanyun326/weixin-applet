<view class="page">
  <view wx:if="{{mealLabel}}" class="logs-head">
    <text class="logs-head__label">{{mealLabel}}</text>
    <text class="muted">共 {{logs.length}} 条操作</text>
  </view>

  <view wx:if="{{loading}}" class="empty"><text class="empty__emoji">⏳</text><text>加载中...</text></view>

  <block wx:elif="{{logs.length}}">
    <view wx:for="{{logs}}" wx:key="_id" class="card log">
      <image class="avatar avatar--sm" src="{{item.operatorAvatar || '/images/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="flex-1 log__body">
        <view class="log__line">
          <text class="log__operator">{{item.operatorName}}</text>
          <text class="log__action log__action--{{item.action}}">{{item.actionText}}</text>
          <text class="log__dish">{{item.dishName}}</text>
        </view>
        <view class="muted log__meta">
          <text wx:if="{{item.action === 'delete'}}">来自 {{item.orderedByName}} 的点菜 · </text>
          <text>操作前状态：{{item.statusText}} · {{item.timeText}}</text>
        </view>
      </view>
    </view>
  </block>

  <view wx:else class="empty">
    <text class="empty__emoji">📝</text>
    <text>还没有操作记录</text>
  </view>
</view>
