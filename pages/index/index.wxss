.profile__info {
  margin-left: 20rpx;
}

.profile__title {
  margin-bottom: 8rpx;
}

.profile__form {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 28rpx 0;
}

.avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  padding: 0;
  line-height: normal;
}

.avatar-btn__hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #FF7043;
}

.input {
  width: 100%;
  height: 88rpx;
  margin-top: 28rpx;
  padding: 0 28rpx;
  border-radius: 44rpx;
  background: #F5F6FA;
  font-size: 28rpx;
}

.openid-debug {
  border: 1rpx dashed #9DDDD4;
  background: linear-gradient(135deg, #FFFFFF, #F3FFFC);
}

.openid-debug__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.openid-debug__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E7F76;
}

.openid-debug__label {
  margin-bottom: 8rpx;
}

.openid-debug__value {
  display: block;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #EDF8F6;
  color: #1E5D57;
  font-family: Menlo, Monaco, monospace;
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}

.openid-debug__actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.openid-debug__tip {
  margin-top: 14rpx;
  line-height: 1.5;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 32rpx 8rpx 4rpx;
}

.family {
  display: flex;
  align-items: center;
}

.family__badge {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 20rpx;
}

.family__meta {
  margin-top: 8rpx;
}

.family__arrow {
  font-size: 44rpx;
  color: #C7CCD4;
}

.create-btn {
  margin-top: 40rpx;
}
