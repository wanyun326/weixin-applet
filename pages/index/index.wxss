.profile__info {
  margin-left: 20rpx;
}

.profile__title {
  margin-bottom: 8rpx;
}

.profile__form {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 28rpx 0;
}

.avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  padding: 0;
  line-height: normal;
}

.avatar-btn__hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #FF7043;
}

.input {
  width: 100%;
  height: 88rpx;
  margin-top: 28rpx;
  padding: 0 28rpx;
  border-radius: 44rpx;
  background: #F5F6FA;
  font-size: 28rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 32rpx 8rpx 4rpx;
}

.family {
  display: flex;
  align-items: center;
}

.family__badge {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 20rpx;
}

.family__meta {
  margin-top: 8rpx;
}

.family__arrow {
  font-size: 44rpx;
  color: #C7CCD4;
}

.create-btn {
  margin-top: 40rpx;
}
