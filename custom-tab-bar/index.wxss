.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: stretch;
  height: 104rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 253, 248, 0.97);
  border-top: 1rpx solid #E5DDD1;
}

.tabbar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #978A7D;
}

.tabbar__text {
  font-size: 24rpx;
  line-height: 1.2;
}

.tabbar__mark {
  width: 20rpx;
  height: 3rpx;
  margin-top: 10rpx;
  border-radius: 2rpx;
  background: transparent;
}

.tabbar__item.is-active {
  color: #8D3D26;
  font-weight: 600;
}

.tabbar__item.is-active .tabbar__mark {
  background: #B85434;
}
